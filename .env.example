# Copy to .env and fill in the providers you use. Only generation and
# judging need keys; every analysis script runs without them.
# The parser is pinned to Llama-3.3-70B on Together, so TOGETHER_API_KEY is
# needed for any generation run. Extra keys (_2, _3) are rotated on rate limits.
TOGETHER_API_KEY=
TOGETHER_API_KEY_2=
TOGETHER_API_KEY_3=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
OPENAI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
